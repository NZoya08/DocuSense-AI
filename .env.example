# Copy this file to .env in the same folder and replace the placeholder values.
# .env is listed in .gitignore, so it is never uploaded to GitHub.

# Required for answers and summaries. Create a key in Google AI Studio.
GEMINI_API_KEY=paste-your-gemini-api-key-here

# Optional. Use a name that scripts/list_models.py shows for your key.
GEMINI_MODEL=gemini-2.5-flash

# Optional. "semantic" uses Sentence-Transformers (default). "keyword" skips the embedding model.
EMBEDDING_BACKEND=semantic
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
